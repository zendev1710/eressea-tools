/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_ABOUTBOX DIALOG  0, 0, 235, 55
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "A propos de EresseaStats"
FONT 8, "MS Sans Serif"
BEGIN
    ICON            IDR_MAINFRAME,IDC_STATIC,11,17,20,20
    LTEXT           "EresseaStats version 1.0 build 3",IDC_STATIC,40,10,119,8,SS_NOPREFIX
    LTEXT           "Copyright (C) Cyril Guillon",IDC_STATIC,40,25,119,8
    DEFPUSHBUTTON   "OK",IDOK,178,7,50,14,WS_GROUP
END

IDD_ERESSEASTATS_DIALOG DIALOGEX 0, 0, 490, 290
STYLE DS_SETFONT | WS_MINIMIZEBOX | WS_MAXIMIZEBOX | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
EXSTYLE WS_EX_APPWINDOW
CAPTION "Regions statistics"
FONT 8, "MS Sans Serif", 0, 0, 0x1
BEGIN
    CONTROL         "List2",IDC_LIST2,"SysListView32",LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_OWNERDRAWFIXED | WS_BORDER | WS_TABSTOP,1,57,485,229
    CONTROL         "Regions with units only",IDC_CHECKOCCUPYEDREGIONSONLY,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,8,5,90,10
    CONTROL         "Sorting based on delta with turn n-1",IDC_CHECKSORTNUM,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,133,21,125,10
    LTEXT           "Number of regions:",IDC_STATIC1,390,21,59,8
    LTEXT           "<value>",IDC_STATIC_REGIONSNUM,456,21,24,8
    CONTROL         "Columns with separator lines",IDC_CHECKSEPARATORLINES,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,8,21,103,10
    CONTROL         "Delta with turn n-1",IDC_CHECKWITHDIFF,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,133,5,116,10
    COMBOBOX        IDC_COMBO_ISLANDS,391,4,92,30,CBS_DROPDOWN | CBS_SORT | WS_VSCROLL | WS_TABSTOP
    CONTROL         "Selected regions only",IDC_CHECKSELECTEDREGIONSONLY,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,274,5,90,10
END


