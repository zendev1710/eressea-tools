/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_ABOUTBOX DIALOG DISCARDABLE  0, 0, 235, 55
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "A propos de RegionStats"
FONT 8, "MS Sans Serif"
BEGIN
    ICON            IDR_MAINFRAME,IDC_STATIC,11,17,20,20
    LTEXT           "RegionStats version 1.0",IDC_STATIC,40,10,119,8,
                    SS_NOPREFIX
    LTEXT           "Copyright (C) 2005",IDC_STATIC,40,25,119,8
    DEFPUSHBUTTON   "OK",IDOK,178,7,50,14,WS_GROUP
END

IDD_ERESSEASTATS_DIALOG DIALOGEX 0, 0, 682, 332
STYLE WS_POPUP
EXSTYLE WS_EX_APPWINDOW
FONT 8, "MS Sans Serif"
BEGIN
    DEFPUSHBUTTON   "OK",IDOK,625,7,50,14
    PUSHBUTTON      "Annuler",IDCANCEL,625,23,50,14
    PUSHBUTTON      "&?",ID_HELP,625,40,50,14
    CONTROL         "List2",IDC_LIST2,"SysListView32",LVS_REPORT | 
                    LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_OWNERDRAWFIXED | 
                    WS_BORDER | WS_TABSTOP,7,65,668,260
    CONTROL         "Regions with units only",IDC_CHECKOCCUPYEDREGIONSONLY,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,8,15,90,10
    CONTROL         "Sorting based on delta with turn n-1",IDC_CHECKSORTNUM,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,133,31,125,10
    LTEXT           "Number of regions:",IDC_STATIC1,7,52,59,8
    LTEXT           "<value>",IDC_STATIC_REGIONSNUM,73,52,24,8
    CONTROL         "Columns with separator lines",IDC_CHECKSEPARATORLINES,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,8,31,103,10
    CONTROL         "Delta with turn n-1",IDC_CHECKWITHDIFF,"Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP,133,15,116,10
END


